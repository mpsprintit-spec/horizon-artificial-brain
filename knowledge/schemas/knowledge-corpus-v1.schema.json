{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-horizon.invalid/schemas/knowledge-corpus-v1.schema.json",
  "title": "Horizon Knowledge Corpus v1",
  "description": "A collection envelope for structured knowledge frames. Validation of each record is delegated to knowledge-frame-v1.schema.json.",
  "type": "object",
  "required": [
    "schema_version",
    "corpus_id",
    "purpose",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "horizon.knowledge-frame.v1"
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "knowledge-frame-v1.schema.json"
      }
    }
  },
  "additionalProperties": false
}
